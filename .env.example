# MinIO (local dev defaults — change in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# ChromaDB (local file persistence when CHROMA_HOST is unset)
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=my_documents

# PostgreSQL (used by docker-compose; local runs fall back gracefully to Demo Mode)
POSTGRES_USER=mocha
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=mocha
DATABASE_URL=postgresql+asyncpg://mocha:change-me-too@postgres:5432/mocha
